# Ghostty config. All keys: ghostty +show-config --default --docs
# Reload: Cmd+Shift+,

# Look
theme = Apple System Colors
# Pure black background, like Apple Terminal (more contrast than the theme's grey)
background = 000000
# Font: Ghostty's built-in JetBrains Mono (includes Nerd Font icons)
font-size = 14
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = native
window-width = 140
window-height = 40

# Behaviour
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = clipboard
window-save-state = always
scrollback-limit = 50000000

# Report the terminal as xterm-256color: every server knows that name, so remote
# shells turn on their colors (Ubuntu's .bashrc colors the prompt only for
# *-256color) and htop/vim work without copying Ghostty's own terminfo.
term = xterm-256color

# Shell integration (zsh is detected automatically).
shell-integration-features = cursor,sudo,title,path
