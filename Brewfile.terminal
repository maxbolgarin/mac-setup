# Terminal: Ghostty, the Starship prompt and the CLI tools .zshrc uses.
cask "ghostty"          # terminal app
brew "starship"         # prompt
brew "fzf"              # Ctrl-R fuzzy history, Ctrl-T file picker
brew "zoxide"           # z <dir>: jump to folders you use often
brew "bat"              # cat with colors (also the man pager)
brew "eza"              # ls replacement
brew "fd"               # fast find (used by fzf)
brew "tree"
brew "htop"
brew "jq"
